{% extends 'base.html.twig' %}

{% block title %}Catalogue Manga{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-12">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold text-slate-800 border-l-4 border-red-500 pl-4">Catalogue Complet</h1>
        
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_manga_new') }}" class="bg-slate-900 hover:bg-slate-800 text-white px-4 py-2 rounded-lg flex items-center gap-2 transition">
                <span>+</span> Ajouter un Manga
            </a>
        {% endif %}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {% for manga in mangas %}
            <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition duration-300 border border-slate-100 flex flex-col h-full">
                <div class="h-64 bg-slate-200 flex items-center justify-center text-slate-400 relative overflow-hidden group">
                    {% if manga.coverImage %}
                         <img src="{{ manga.coverImage }}" alt="{{ manga.title }}" class="w-full h-full object-cover">
                    {% else %}
                         <span class="text-4xl">📚</span>
                    {% endif %}
                    
                    <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition flex items-center justify-center gap-2">
                        <a href="{{ path('app_manga_show', {'id': manga.id}) }}" class="bg-white text-slate-900 px-3 py-1 rounded-full text-sm font-bold hover:bg-red-500 hover:text-white transition">Voir</a>
                        
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_manga_edit', {'id': manga.id}) }}" class="bg-slate-900 text-white px-3 py-1 rounded-full text-sm hover:bg-blue-600 transition">Éditer</a>
                        {% endif %}
                    </div>
                </div>

                <div class="p-5 flex flex-col flex-grow">
                    <div class="flex-grow">
                        <h5 class="font-bold text-lg text-slate-800 mb-1 line-clamp-1">{{ manga.title }}</h5>
                        <p class="text-slate-500 text-sm mb-3">{{ manga.author }}</p>
                    </div>
                    
                    <div class="pt-4 border-t border-slate-100 flex justify-between items-center mt-auto">
                        <span class="text-red-600 font-extrabold text-xl">{{ manga.price }} €</span>
                        
                        <a href="{{ path('app_cart_add', {'id': manga.id}) }}" class="bg-slate-900 text-white p-2 rounded-full hover:bg-red-600 transition" title="Ajouter au panier">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                        </a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-span-4 text-center py-12 text-slate-500">
                Aucun manga trouvé.
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}{{ manga.title }} - Détails{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-12">
    <a href="{{ path('app_manga_index') }}" class="inline-flex items-center gap-2 text-slate-500 hover:text-slate-800 transition mb-8">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
        Retour au catalogue
    </a>

    <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-slate-100">
        <div class="grid grid-cols-1 md:grid-cols-2">
            
            <div class="bg-slate-100 flex items-center justify-center p-8 min-h-[400px]">
                {% if manga.coverImage %}
                    <img src="{{ manga.coverImage }}" alt="{{ manga.title }}" class="max-h-[500px] w-auto shadow-2xl rounded-lg transform hover:scale-105 transition duration-500">
                {% else %}
                    <div class="text-slate-400 flex flex-col items-center">
                        <span class="text-9xl">📚</span>
                        <p class="mt-4 font-medium">Pas d'image disponible</p>
                    </div>
                {% endif %}
            </div>

            <div class="p-8 md:p-12 flex flex-col justify-center">
                <div class="mb-6">
                    <p class="text-red-500 font-bold tracking-wider uppercase text-sm mb-2">{{ manga.author }}</p>
                    <h1 class="text-4xl md:text-5xl font-extrabold text-slate-800 mb-6 leading-tight">{{ manga.title }}</h1>
                    
                    <div class="text-3xl font-bold text-red-600 mb-8">{{ manga.price }} €</div>
                    
                    <div class="prose prose-slate text-slate-600 mb-8">
                        <h3 class="text-lg font-bold text-slate-800 mb-2">Synopsis</h3>
                        <p class="leading-relaxed">{{ manga.description|nl2br }}</p>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-4 border-t border-slate-100 pt-8 mt-auto">
                    <a href="{{ path('app_cart_add', {'id': manga.id}) }}" class="flex-1 bg-slate-900 text-white px-8 py-4 rounded-xl font-bold hover:bg-red-600 transition flex justify-center items-center gap-2 shadow-lg hover:shadow-red-500/30 transform active:scale-95">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                        Ajouter au panier
                    </a>
                </div>

                {% if is_granted('ROLE_ADMIN') %}
                    <div class="mt-8 pt-8 border-t border-dashed border-slate-300 bg-slate-50 p-4 rounded-xl">
                        <h4 class="text-xs font-bold text-slate-400 uppercase mb-4 flex items-center gap-2">
                            <span>🛠️ Zone Admin</span>
                        </h4>
                        <div class="flex gap-4">
                            <a href="{{ path('app_manga_edit', {'id': manga.id}) }}" class="flex-1 bg-white border border-slate-300 text-slate-700 px-4 py-2 rounded-lg font-bold hover:bg-slate-50 transition text-center text-sm">
                                ✏️ Modifier
                            </a>
                            
                            {# Formulaire de suppression sécurisé #}
                            <form method="post" action="{{ path('app_manga_delete', {'id': manga.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce manga ?');" class="flex-1">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ manga.id) }}">
                                <button class="w-full bg-red-100 text-red-600 border border-red-200 px-4 py-2 rounded-lg font-bold hover:bg-red-200 transition text-sm">
                                    🗑️ Supprimer
                                </button>
                            </form>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
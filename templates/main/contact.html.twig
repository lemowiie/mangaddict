{% extends 'base.html.twig' %}

{% block title %}Contactez-nous - MangaAddict{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-12 max-w-2xl">
    <h1 class="text-3xl font-bold mb-6 text-center text-slate-800">Nous Contacter</h1>
    

    <div class="bg-white p-8 rounded-xl shadow-lg border border-slate-100">
        <form action="#" method="post" class="space-y-6">
            <div>
                <label for="name" class="block font-medium mb-1 text-slate-700">Votre Nom</label>
                <input type="text" id="name" name="name" class="w-full border border-slate-300 p-3 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition" required placeholder="Jean Dupont">
            </div>
            
            <div>
                <label for="email" class="block font-medium mb-1 text-slate-700">Email</label>
                <input type="email" id="email" name="email" class="w-full border border-slate-300 p-3 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition" required placeholder="jean@exemple.com">
            </div>
            
            <div>
                <label for="message" class="block font-medium mb-1 text-slate-700">Message</label>
                <textarea id="message" name="message" rows="5" class="w-full border border-slate-300 p-3 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition" required placeholder="Votre message ici..."></textarea>
            </div>
            
            <button type="submit" class="w-full bg-red-600 text-white font-bold py-3 rounded-lg hover:bg-red-700 transition transform active:scale-95">
                Envoyer le message
            </button>
        </form>
    </div>
</div>
{% endblock %}
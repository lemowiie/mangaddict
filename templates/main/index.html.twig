{% extends 'base.html.twig' %}

{% block title %}Accueil - MangaAddict{% endblock %}

{% block body %}
<div class="space-y-12 mb-12">
    <div class="bg-slate-800 text-white py-20 px-4 rounded-b-3xl shadow-xl text-center">
        <h1 class="text-4xl md:text-6xl font-extrabold mb-6">
            Plongez dans l'univers <span class="text-red-500">Manga</span>
        </h1>
        <p class="text-xl text-slate-300 mb-8 max-w-2xl mx-auto">
            Découvrez les dernières nouveautés et gérez votre collection.
        </p>
        <a href="{{ path('app_manga_index') }}" class="inline-block bg-red-600 hover:bg-red-700 text-white px-8 py-3 rounded-full font-bold text-lg transition transform hover:scale-105">
            Voir le catalogue
        </a>
    </div>

    <div class="container mx-auto px-4">
        <h3 class="text-3xl font-bold text-slate-800 mb-8 border-l-4 border-red-500 pl-4">
            Derniers ajouts
        </h3>
        
        {% if mangas is empty %}
            <div class="bg-white p-8 rounded-xl border border-slate-200 text-center">
                <span class="text-4xl">📭</span>
                <p class="text-slate-600 mt-2 font-medium">Aucun manga trouvé.</p>
                <p class="text-sm text-slate-400">Veuillez ajouter des mangas dans la base de données (table `manga`).</p>
            </div>
        {% else %}
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {% for manga in mangas %}
                    <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition duration-300 border border-slate-100 flex flex-col h-full group">
                        
                        <div class="h-64 bg-slate-200 flex items-center justify-center text-slate-400 relative overflow-hidden">
                            {% if manga.coverImage %}
                                <img src="{{ manga.coverImage }}" alt="{{ manga.title }}" class="w-full h-full object-cover transition duration-500 group-hover:scale-110">
                            {% else %}
                                <span class="text-6xl">📚</span>
                            {% endif %}
                            
                            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                                <a href="{{ path('app_manga_show', {'id': manga.id}) }}" class="bg-white text-slate-900 px-6 py-2 rounded-full font-bold hover:bg-red-600 hover:text-white transition transform hover:scale-105">
                                    Voir détails
                                </a>
                            </div>
                        </div>

                        <div class="p-6 flex flex-col flex-grow">
                            <div class="flex-grow">
                                <h4 class="font-bold text-xl mb-1 text-slate-800 line-clamp-1">{{ manga.title }}</h4>
                                <p class="text-slate-500 text-sm mb-3 font-medium">{{ manga.author }}</p>
                                <p class="text-slate-600 text-sm mb-4 line-clamp-2">{{ manga.description }}</p>
                            </div>
                            
                            <div class="pt-4 border-t border-slate-100 flex justify-between items-center mt-auto">
                                <span class="text-red-600 font-extrabold text-2xl">{{ manga.price }} €</span>
                                
                                {# BOUTON PANIER FONCTIONNEL #}
                                <a href="{{ path('app_cart_add', {'id': manga.id}) }}" class="bg-slate-900 text-white px-4 py-2 rounded-full hover:bg-red-600 transition flex items-center gap-2 text-sm font-bold shadow-lg">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                                    Ajouter
                                </a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
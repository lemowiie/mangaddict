{% extends 'base.html.twig' %}

{% block title %}Mon Profil - MangaAddict{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <div class="md:col-span-1">
            <div class="bg-white rounded-xl shadow-lg p-6 border border-slate-100 sticky top-24">
                <div class="flex items-center gap-4 mb-6 pb-6 border-b border-slate-100">
                    <div class="bg-slate-200 p-4 rounded-full text-slate-500">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </div>
                    <div>
                        <h1 class="text-xl font-bold text-slate-800">{{ app.user.firstname }} {{ app.user.lastname }}</h1>
                        <p class="text-sm text-slate-500">{{ app.user.email }}</p>
                    </div>
                </div>

                <div class="space-y-4">
                    <a href="{{ path('app_profile_edit') }}" class="block w-full text-center bg-slate-900 text-white py-2 rounded-lg hover:bg-slate-800 transition">
                        Modifier mes informations
                    </a>
                    
                    <form method="post" action="{{ path('app_profile_delete') }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer votre compte ? Cette action est irréversible.');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ app.user.id) }}">
                        <button class="block w-full text-center border border-red-200 text-red-600 py-2 rounded-lg hover:bg-red-50 transition">
                            Supprimer mon compte
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="md:col-span-2">
            <h2 class="text-2xl font-bold text-slate-800 mb-6 flex items-center gap-2">
                <span>📦</span> Mes Commandes
            </h2>

            {# Vérification si l'utilisateur a des commandes #}
            {# On utilise app.user.commandes (Relation OneToMany) #}
            {% if app.user.commandes is empty %}
                <div class="bg-white p-8 rounded-xl shadow border border-slate-100 text-center">
                    <p class="text-slate-500 text-lg mb-4">Vous n'avez passé aucune commande pour le moment.</p>
                    <a href="{{ path('app_manga_index') }}" class="text-red-600 font-bold hover:underline">Découvrir le catalogue</a>
                </div>
            {% else %}
                <div class="space-y-6">
                    {# On inverse l'ordre pour voir les plus récentes en premier (si possible via filtre ou controlleur, ici ordre par défaut) #}
                    {% for commande in app.user.commandes|reverse %}
                        <div class="bg-white rounded-xl shadow-md border border-slate-100 overflow-hidden">
                            <div class="bg-slate-50 p-4 border-b border-slate-100 flex justify-between items-center">
                                <div>
                                    <span class="text-xs font-bold text-slate-400 uppercase">Commande #{{ commande.id }}</span>
                                    <p class="text-sm font-bold text-slate-700">Du {{ commande.createdAt|date('d/m/Y à H:i') }}</p>
                                </div>
                                <div class="text-right">
                                    <span class="block text-xl font-extrabold text-red-600">{{ commande.total }} €</span>
                                    <span class="text-xs text-green-600 bg-green-100 px-2 py-0.5 rounded-full font-bold">Validée</span>
                                </div>
                            </div>
                            <div class="p-6">
                                <h4 class="text-sm font-bold text-slate-500 mb-2 uppercase">Détail des articles :</h4>
                                <p class="text-slate-700 leading-relaxed">
                                    {# On affiche le contenu texte stocké dans la commande #}
                                    {{ commande.contenu }}
                                </p>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

    </div>
</div>
{% endblock %}
<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>📚</text></svg>">
        <script src="https://cdn.tailwindcss.com"></script>
    </head>
    <body class="bg-slate-50 text-slate-900 font-sans min-h-screen flex flex-col">
        <nav class="bg-slate-900 text-white p-4 shadow-lg sticky top-0 z-50">
            <div class="container mx-auto flex justify-between items-center">
                <a href="{{ path('app_home') }}" class="text-2xl font-bold text-red-500 flex items-center gap-2">
                    MangaAddict
                </a>
                
                <div class="hidden md:flex gap-6 items-center">
                    <a href="{{ path('app_home') }}" class="hover:text-red-400 transition">Accueil</a>
                    <a href="{{ path('app_manga_index') }}" class="hover:text-red-400 transition">Catalogue</a>
                    
                    {# LIEN PANIER AJOUTÉ ICI #}
                    <a href="{{ path('app_cart') }}" class="hover:text-red-400 transition flex items-center gap-1">
                        Panier
                    </a>
                    
                    <a href="{{ path('app_contact') }}" class="hover:text-red-400 transition">Contact</a>
                    
                    {% if app.user %}
                        <div class="flex items-center gap-3 ml-4">
                            {% if is_granted('ROLE_ADMIN') %}
                                <span class="bg-red-600 text-xs px-2 py-1 rounded font-bold">ADMIN</span>
                            {% endif %}
                            <a href="{{ path('app_profile') }}" class="bg-slate-800 px-4 py-2 rounded-full hover:bg-slate-700 transition flex items-center gap-2">
                                👤 {{ app.user.firstname|default('Mon Compte') }}
                            </a>
                            <a href="{{ path('app_logout') }}" class="text-red-500 hover:text-red-400" title="Se déconnecter">⏻</a>
                        </div>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="bg-red-600 px-4 py-2 rounded font-bold hover:bg-red-700 transition ml-4">
                            Connexion
                        </a>
                    {% endif %}
                </div>
            </div>
        </nav>

        <main class="flex-grow">
            {% block body %}{% endblock %}
        </main>
        
        <footer class="bg-slate-900 text-slate-400 py-8 mt-12 text-center">
            <div class="container mx-auto space-x-4">
                <span>© 2024 MangaAddict</span>
                <span>|</span>
                <a href="{{ path('app_legal') }}" class="hover:text-white">Mentions Légales</a>
                <span>|</span>
                <a href="{{ path('app_cgu') }}" class="hover:text-white">CGU</a>
            </div>
        </footer>
    </body>
</html>
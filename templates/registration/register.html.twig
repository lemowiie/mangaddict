{% extends 'base.html.twig' %}

{% block title %}Inscription - MangaAddict{% endblock %}

{% block body %}
<div class="flex justify-center items-center py-20 px-4">
    <div class="bg-white p-8 rounded-xl shadow-2xl w-full max-w-md border-t-4 border-red-500">
        <h1 class="text-2xl font-bold mb-6 text-center text-slate-800">Créer un compte</h1>

        {{ form_start(registrationForm, {'attr': {'class': 'space-y-4'}}) }}

            <div class="text-red-600 text-sm">
                {{ form_errors(registrationForm) }}
            </div>

            <div>
                {{ form_label(registrationForm.firstname, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                {{ form_widget(registrationForm.firstname, {'attr': {'class': 'w-full border border-slate-300 p-3 rounded-lg focus:ring-2 focus:ring-red-500 outline-none transition'}}) }}
                <div class="text-red-500 text-xs mt-1">{{ form_errors(registrationForm.firstname) }}</div>
            </div>

            <div>
                {{ form_label(registrationForm.lastname, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                {{ form_widget(registrationForm.lastname, {'attr': {'class': 'w-full border border-slate-300 p-3 rounded-lg focus:ring-2 focus:ring-red-500 outline-none transition'}}) }}
                <div class="text-red-500 text-xs mt-1">{{ form_errors(registrationForm.lastname) }}</div>
            </div>

            <div>
                {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                {{ form_widget(registrationForm.email, {'attr': {'class': 'w-full border border-slate-300 p-3 rounded-lg focus:ring-2 focus:ring-red-500 outline-none transition'}}) }}
                <div class="text-red-500 text-xs mt-1">{{ form_errors(registrationForm.email) }}</div>
            </div>

            <div>
                {{ form_label(registrationForm.plainPassword, 'Mot de passe', {'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'w-full border border-slate-300 p-3 rounded-lg focus:ring-2 focus:ring-red-500 outline-none transition'}}) }}
                <div class="text-red-500 text-xs mt-1">{{ form_errors(registrationForm.plainPassword) }}</div>
            </div>

            <div class="flex items-start gap-3 mt-2">
                {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'mt-1 w-4 h-4 text-red-600 focus:ring-red-500 border-gray-300 rounded'}}) }}
                <label for="{{ registrationForm.agreeTerms.vars.id }}" class="text-sm text-slate-600 leading-tight">
                    J'accepte les <a href="{{ path('app_cgu') }}" class="text-red-600 underline hover:text-red-800">conditions générales d'utilisation (CGU)</a>.
                </label>
            </div>
            <div class="text-red-500 text-xs">{{ form_errors(registrationForm.agreeTerms) }}</div>

            <button type="submit" class="w-full bg-slate-900 text-white py-3 rounded-lg font-bold hover:bg-slate-800 transition transform active:scale-95 mt-6">
                S'inscrire
            </button>

        {{ form_end(registrationForm) }}

        <div class="mt-6 text-center pt-6 border-t border-slate-100">
            <p class="text-sm text-slate-600">
                Déjà un compte ? 
                <a href="{{ path('app_login') }}" class="text-red-600 font-bold hover:underline">
                    Se connecter
                </a>
            </p>
        </div>
    </div>
</div>
{% endblock %}